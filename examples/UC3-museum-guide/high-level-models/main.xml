<?xml version="1.0" encoding="UTF-8"?>
<roaml>
    <parameters>
        <max_time value="100" unit="s" />
        <bt_tick_rate value="10.0" />
        <bt_tick_if_not_running value="true" />
    </parameters>

    <behavior_tree>
        <input type="bt.cpp-xml" src="./bt_policies/Policy.xml" />
        <input type="bt-plugin-ascxml" src="./bt_plugins/ROS2Condition.ascxml" />
        <input type="bt-plugin-ascxml" src="./bt_plugins/ROS2Action.ascxml" />
    </behavior_tree>

    <node_models>
        <input type="node-ascxml" src="./components/BatteryComponent.ascxml" />
        <input type="node-ascxml" src="./components/NotifyUserComponent.ascxml" />
        <input type="node-ascxml" src="./components/BlackboardComponent.ascxml" />
        <input type="node-ascxml" src="./components/SchedulerComponent.ascxml" />
        <input type="node-ascxml" src="./components/PeopleDetectorFilterComponent.ascxml" />
        <input type="node-ascxml" src="./components/NavigationComponent.ascxml" />
        <input type="node-ascxml" src="./skills/BatteryLevelSkill.ascxml" />
        <input type="node-ascxml" src="./skills/AlarmSkill.ascxml" />
        <input type="node-ascxml" src="./skills/IsPoiDone1Skill.ascxml" />
        <input type="node-ascxml" src="./skills/IsPoiDone2Skill.ascxml" />
        <input type="node-ascxml" src="./skills/SetPoi1Skill.ascxml" />
        <input type="node-ascxml" src="./skills/SetPoi2Skill.ascxml" />
        <input type="node-ascxml" src="./skills/ResetSkill.ascxml" />
        <input type="node-ascxml" src="./skills/SetCurrentPoiDoneSkill.ascxml" />
        <input type="node-ascxml" src="./skills/VisitorsFollowingRobotSkill.ascxml" />
        <input type="node-ascxml" src="./skills/WaitSkill.ascxml" />
        <input type="node-ascxml" src="./skills/GoToPoiActionSkill.ascxml" />
    </node_models>

    <properties>
        <!-- <input type="xml" src="./Properties/properties.xml" /> -->
        <input type="jani" src="./properties/properties.jani" />
    </properties>
</roaml>
