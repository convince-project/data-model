<?xml version="1.0" encoding="UTF-8"?>
<ascxml xmlns="http://www.w3.org/2005/07/ascxml"
       version="1.0"
       name="NavigationComponent"
       initial="idle"
       datamodel="ecmascript">

  <datamodel>
    <data id="GOAL_REACHED" type="int32" expr="4" />
    <data id="ABORTED" type="int32" expr="5" />
    <data id="MOVING" type="int32" expr="2" />
    <data id="IDLE" type="int32" expr="0" />
    <data id="goal_name" type="string" expr="''" />
    <data id="goal_id" type="int32" expr="0" />
    <data id="start_time" type="int32" expr="0" />
    <data id="navigation_time" type="int32" expr="0" />
    <data id="current_time" type="int32" expr="0" />
    <data id="current_position" type="string" expr="''" />
    <data id="navigation_timeout" type="int32" expr="30" />
    <!-- <data id="poi_name" type="string" expr="" /> -->
    <!-- <data id="poi_number" type="int32" expr="0" /> -->
    <!-- Exec fields -->
    <data id="is_near" type="bool" expr="false" />
    <data id="status" type="int32" expr="0" />
    <!-- temp variables -->
  </datamodel>

  <!-- Service servers -->
  <!-- <ros_service_server service_name="/NavigationComponent/GoToPoiByName" type="navigation_interfaces/GoToPoiByName"/> -->
  <ros_service_server service_name="/NavigationComponent/GetNavigationStatus" type="navigation_interfaces/GetNavigationStatus"/>
  <ros_service_server service_name="/NavigationComponent/StopNavigation" type="navigation_interfaces/StopNavigation"/>
  <ros_service_server service_name="/NavigationComponent/CheckNearToPoi" type="navigation_interfaces/CheckNearToPoi"/>
  <ros_service_server service_name="/NavigationComponent/TurnBack" type="navigation_interfaces/TurnBack"/>
  <ros_topic_subscriber topic_name="/NavigationComponent/NavigationStatus" name="clock_sub" type="builtin_interfaces/msg/Time" topic="clock"/>
  <!-- Action server -->
  <ros_action_server name="goto_act" action_name="/NavigationComponent/GoToPoi" type="navigation_interfaces/GoToPoi"/>
  <!-- <ros_time_rate name="action_timer" rate_hz="10"/> -->

  <state id="idle">

    <!-- GetNavigationStatus -->
    <ros_service_handle_request name="/NavigationComponent/GetNavigationStatus" target="idle">
      <ros_service_send_response name="/NavigationComponent/GetNavigationStatus">
        <field name="is_ok"         expr="true"/>
        <field name="current_goal"  expr="goal_name"/>
        <field name="status" expr="status"/>
        <field name="error_msg"     expr="''"/>
      </ros_service_send_response>
    </ros_service_handle_request>
    <!-- StopNavigation -->
    <ros_service_handle_request name="/NavigationComponent/StopNavigation" target="idle">
      <assign location="goal_name" expr="''"/>
      <assign location="goal_id"   expr="0"/>
      <assign location="status"    expr="ABORTED"/>
      <assign location="is_near"   expr="false"/>
      <ros_action_aborted name="goto_act" goal_id="goal_id">
      </ros_action_aborted>
    </ros_service_handle_request>
    <!-- CheckNearToPoi -->
    <ros_service_handle_request name="/NavigationComponent/CheckNearToPoi" target="idle">
      <if cond="status == GOAL_REACHED &amp;&amp; current_position == _msg.poi_name">
        <ros_service_send_response name="/NavigationComponent/CheckNearToPoi">
          <field name="is_ok"      expr="true"/>
          <field name="is_near"    expr="true"/>
          <field name="error_msg"  expr="''"/>
        </ros_service_send_response>
      <else/>
        <ros_service_send_response name="/NavigationComponent/CheckNearToPoi">
          <field name="is_ok"      expr="true"/>
          <field name="is_near"    expr="false"/>
          <field name="error_msg"  expr="''"/>
        </ros_service_send_response>
      </if>
    </ros_service_handle_request>
    <!-- TurnBack -->
    <ros_service_handle_request name="/NavigationComponent/TurnBack" target="idle">
      <ros_service_send_response name="/NavigationComponent/TurnBack">
        <field name="is_ok"      expr="true"/>
        <field name="error_msg"  expr="''"/>
      </ros_service_send_response>
    </ros_service_handle_request>
    <!-- Action‐goal -->
    <ros_action_handle_goal name="goto_act" target="getCurrentTimeForGoal">
      <assign location="status" expr="MOVING"/>
      <assign location="goal_name" expr="_goal.poi_name"/>
      <assign location="current_position" expr="''"/>
      <ros_action_accept_goal name="goto_act" goal_id="goal_id"/>

    </ros_action_handle_goal>

    <!-- <ros_action_handle_cancel name="goto_act" target="HandleActionCancel"/> -->
  </state>




<!-- 
  <state id="HandleTurnBack">
    <onentry>
      <ros_service_send_response name="/NavigationComponent/TurnBack">
        <field name="is_ok"      expr="_callSucceeded()"/>
        <field name="error_msg"  expr="_callSucceeded() ? '' : _errorMessage()"/>
      </ros_service_send_response>
    </onentry>
    <transition target="idle"/>
  </state> -->

  <state id="getCurrentTimeForGoal">
    <ros_topic_callback name="clock_sub" target="navigating">
      <assign location="current_time" expr="_msg.sec"/>
    </ros_topic_callback>
    <ros_service_handle_request name="/NavigationComponent/StopNavigation" target="getCurrentTimeForGoal">
        <assign location="goal_name" expr="''"/>
        <assign location="goal_id"   expr="0"/>
        <assign location="status"    expr="ABORTED"/>
        <assign location="is_near"   expr="false"/>
        <ros_action_aborted name="goto_act" goal_id="goal_id">
        </ros_action_aborted>
    </ros_service_handle_request>

    <ros_service_handle_request name="/NavigationComponent/GetNavigationStatus" target="getCurrentTimeForGoal">
      <ros_service_send_response name="/NavigationComponent/GetNavigationStatus">
        <field name="is_ok"         expr="true"/>
        <field name="current_goal"  expr="goal_name"/>
        <field name="status" expr="status"/>
        <field name="error_msg"     expr="''"/>
      </ros_service_send_response>
    </ros_service_handle_request>
    <ros_service_handle_request name="/NavigationComponent/CheckNearToPoi" target="getCurrentTimeForGoal">
      <if cond="status == GOAL_REACHED &amp;&amp; current_position == _msg.poi_name">
        <ros_service_send_response name="/NavigationComponent/CheckNearToPoi">
          <field name="is_ok"      expr="true"/>
          <field name="is_near"    expr="true"/>
          <field name="error_msg"  expr="''"/>
        </ros_service_send_response>
      <else/>
        <ros_service_send_response name="/NavigationComponent/CheckNearToPoi">
          <field name="is_ok"      expr="true"/>
          <field name="is_near"    expr="false"/>
          <field name="error_msg"  expr="''"/>
        </ros_service_send_response>
      </if>
    </ros_service_handle_request>
    <ros_service_handle_request name="/NavigationComponent/TurnBack" target="getCurrentTimeForGoal">
      <ros_service_send_response name="/NavigationComponent/TurnBack">
        <field name="is_ok"      expr="true"/>
        <field name="error_msg"  expr="''"/>
      </ros_service_send_response>
    </ros_service_handle_request>
  </state>

  <state id="handleNavigating">
    <transition>
            <target id="GetTimeWhileNavigating" prob="0.99">
              <!-- success -->
              <assign location="status" expr="MOVING" />
            </target>
            <target id="NavigationAborted" prob="0.01">
                <!-- failure -->
                <assign location="status" expr="ABORTED" />
                <assign location="is_near" expr="false" />
                <!-- <ros_action_abort name="goto_act" goal_id="goal_id">
                  <field name="is_ok" expr="false"/>
                  <field name="error_msg" expr="'goal aborted'"/>
                </ros_action_abort> -->
            </target>
          </transition>

  </state>

  <state id="GetTimeWhileNavigating">
    <ros_topic_callback name="clock_sub" target="navigating">
      <assign location="current_time" expr="_msg.sec"/>
    </ros_topic_callback>
    <ros_service_handle_request name="/NavigationComponent/StopNavigation" target="HandleStopNavigation"/>
    <ros_service_handle_request name="/NavigationComponent/GetNavigationStatus" target="GetTimeWhileNavigating">
      <ros_service_send_response name="/NavigationComponent/GetNavigationStatus">
        <field name="is_ok"         expr="true"/>
        <field name="current_goal"  expr="goal_name"/>
        <field name="status" expr="status"/>
        <field name="error_msg"     expr="''"/>
      </ros_service_send_response>
    </ros_service_handle_request>
    <ros_service_handle_request name="/NavigationComponent/CheckNearToPoi" target="GetTimeWhileNavigating">
      <if cond="status == GOAL_REACHED &amp;&amp; current_position == _msg.poi_name">
        <ros_service_send_response name="/NavigationComponent/CheckNearToPoi">
          <field name="is_ok"      expr="true"/>
          <field name="is_near"    expr="true"/>
          <field name="error_msg"  expr="''"/>
        </ros_service_send_response>
      <else/>
        <ros_service_send_response name="/NavigationComponent/CheckNearToPoi">
          <field name="is_ok"      expr="true"/>
          <field name="is_near"    expr="false"/>
          <field name="error_msg"  expr="''"/>
        </ros_service_send_response>
      </if>
    </ros_service_handle_request>
    <ros_service_handle_request name="/NavigationComponent/TurnBack" target="GetTimeWhileNavigating">
      <ros_service_send_response name="/NavigationComponent/TurnBack">
        <field name="is_ok"      expr="true"/>
        <field name="error_msg"  expr="''"/>
      </ros_service_send_response>
    </ros_service_handle_request>
  </state>

  <state id="navigating">
    <onentry>
      <if cond="current_time - start_time  > navigation_timeout">
        <!-- Timeout reached, goal reached -->
        <assign location="status" expr="GOAL_REACHED" />
        <assign location="is_near" expr="true" />
        <assign location="current_position" expr="goal_name"/>
        <ros_action_succeed name="goto_act" goal_id="goal_id" >
            <field name="is_ok" expr="true"/>
            <field name="error_msg" expr="''"/>
        </ros_action_succeed>
        <assign location="goal_id" expr="0"/>

      </if>
    </onentry>
      <transition cond="status == MOVING" target="handleNavigating"/>
      <transition target="idle"/>
    
  </state>

</ascxml>