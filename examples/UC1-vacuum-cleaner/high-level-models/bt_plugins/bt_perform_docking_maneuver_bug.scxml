<?xml version="1.0" encoding="UTF-8"?>
<ascxml
    initial="initial"
    name="PerformDockingManeuver"
    model_src=""
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../../data-format-specifications/skill-components-(A)SCXML/ascxml_component.xsd">

    <ros_topic_publisher name="cmd" topic="/cmd_vel" type="std_msgs/Int16" />

    <state id="initial">
        <bt_tick target="initial">
            <ros_topic_publish name="cmd">
                <field name="data" expr="2" />
            </ros_topic_publish>
            <bt_return_status status="SUCCESS" />
        </bt_tick>
        <bt_halt target="initial">
            <bt_return_halted />
        </bt_halt>
    </state>

</ascxml>
