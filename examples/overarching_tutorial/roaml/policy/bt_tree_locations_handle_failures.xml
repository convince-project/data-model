<root BTCPP_format="4">
    <BehaviorTree ID="OverarchingTutorialLocationFailures">
        <Sequence name="main_sequence">
            <SetBlackboard output_key="current_location" value="'fridge'"/>
            <Inverter>
                <Repeat name="reach_and_detect_attempt" num_cycles="3">
                    <Sequence>
                        <GetNextLocation name="get_next_loc" location="{current_location}" />
                        <RetryUntilSuccessful name="navigation_to_obj_attempts" num_attempts="4">
                            <NavigateToLocation name="navigate_to_obj" target="{current_location}" />
                        </RetryUntilSuccessful>
                        <Inverter>
                            <Fallback name="detection_or_get_next">
                                <RetryUntilSuccessful name="detection_attempts" num_attempts="3">
                                    <DetectObject name="detect_obj" object="butter" />
                                </RetryUntilSuccessful>
                                <Inverter>
                                    <GetNextLocation name="get_next_loc" location="{current_location}" />
                                </Inverter>
                            </Fallback>
                        </Inverter>
                    </Sequence>
                </Repeat>
            </Inverter>
            <RetryUntilSuccessful name="pick_attempts" num_attempts="3">
                <PickObject name="pick_obj" object="butter" />
            </RetryUntilSuccessful>
            <RetryUntilSuccessful name="navigation_to_start_attempts" num_attempts="4">
                <NavigateToLocation name="navigate_to_start" target="'dining_table'" />
            </RetryUntilSuccessful>
            <ROS2Action name="place_action_skill" service_name_tick="/PlaceObjectSkill/tick"  
                                service_name_halt="/PlaceObjectSkill/halt" interface="ROS2SERVICE" isMonitored="false"/>
        </Sequence>
    </BehaviorTree>
</root>
