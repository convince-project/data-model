<roaml>
    <parameters>
        <max_time value="100" unit="s" />
        <max_array_size value="10" />
        <bt_tick_rate value="0.5" />
    </parameters>

    <behavior_tree>
        <input type="bt.cpp-xml" src="./bt_policies/Policy0.xml" />
        <input type="bt-plugin-ascxml" src="./bt_plugins/SelectBlock.ascxml" />
        <input type="bt-plugin-ascxml" src="./bt_plugins/ComputeBestGraspPose.ascxml" />
        <input type="bt-plugin-ascxml" src="./bt_plugins/ComputeBestPlacePose.ascxml" />
        <input type="bt-plugin-ascxml" src="./bt_plugins/MoveTo.ascxml" />
        <input type="bt-plugin-ascxml" src="./bt_plugins/CloseGripper.ascxml" />
        <input type="bt-plugin-ascxml" src="./bt_plugins/OpenGripper.ascxml" />
        <input type="bt-plugin-ascxml" src="./bt_plugins/RecoverBlock.ascxml" />
        <input type="bt-plugin-ascxml" src="./bt_plugins/CheckBlockHasFallen.ascxml" />
        <input type="bt-plugin-ascxml" src="./bt_plugins/CheckGripperIsEmpty.ascxml" />
    </behavior_tree>

    <node_models>
        <input type="node-ascxml" src="./skills/ComputeBestGraspPoseSkill.ascxml" />
        <input type="node-ascxml" src="./skills/ComputeBestPlacePoseSkill.ascxml" />
        <input type="node-ascxml" src="./skills/MoveToSkill.ascxml" />
        <input type="node-ascxml" src="./skills/CloseGripperSkill.ascxml" />
        <input type="node-ascxml" src="./skills/OpenGripperSkill.ascxml" />
        <input type="node-ascxml" src="./skills/RecoverBlockSkill.ascxml" />
        <input type="node-ascxml" src="./skills/Environment.ascxml" />
    </node_models>

    <properties>
        <input type="jani" src="./properties/properties.jani" />
    </properties>
</roaml>
